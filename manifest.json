{
  "manifest_version": 3,
  "name": "Almanac (formerly Tabby)",
  "version": "0.1.0",
  "description": "The seasons, one tab at a time.",
  "permissions": [
    "storage"
  ],
  "optional_permissions": [
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
