{
  "manifest_version": 3,
  "name": "Tabby",
  "version": "0.0.1",
  "description": "A beautiful new tab page and link manager with seasonal backgrounds and synchronized data",
  "permissions": ["storage"],
  "chrome_url_overrides": {
    "newtab": "new-tab.html"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
